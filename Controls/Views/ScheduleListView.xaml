<UserControl x:Class="Controls.Views.ScheduleListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Controls.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <!-- 外层卡片：白色背景 + 圆角 + 内边距 -->
    <Border Background="{DynamicResource BgSidebar}" CornerRadius="8" Padding="15">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Viewbox Stretch="Uniform" StretchDirection="Both">
                <!-- 基准宽度和列表项保持一致（都用 650） -->
                <Grid Width="650">
                    <TextBlock Text="今日日程" FontSize="18" FontWeight="Bold" 
               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,15"
               HorizontalAlignment="Left"/>
                </Grid>
            </Viewbox>

            <!-- 列表容器：带 ScrollViewer，防止日程过多撑爆界面 -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                      Padding="0,1,0,0"
                      HorizontalScrollBarVisibility="Disabled">
                <!-- 外层 Border：负责画标题下的第一条横线 -->
                <Border BorderBrush="#A8E6E8" BorderThickness="0,1,0,0">
                    <!-- ItemsSource 绑定到外部的集合，这里直接用 {Binding} 代表当前 DataContext -->
                    <ItemsControl ItemsSource="{Binding}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#A8E6E8" BorderThickness="0,0,0,1">
                                    <Viewbox Stretch="Uniform" StretchDirection="Both"
                                         HorizontalAlignment="Stretch">
                                        <!--基准宽度为650-->
                                        <Grid  Width="650" Margin="0,10,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- 时间区域 -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}" 
                                                       FontSize="13" FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding EndTime, StringFormat=' -{0:HH:mm}'}" 
                                                       FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>

                                            <!-- 左侧彩色线条：根据 Status 自动变色 -->
                                            <Border Grid.Column="1" Width="2" CornerRadius="2" Margin="0,0,10,0" 
                                                VerticalAlignment="Stretch" MinHeight="40">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <!-- 默认颜色（灰色） -->
                                                        <Setter Property="Background" Value="#E0E0E0"/>
                                                        <Style.Triggers>
                                                            <!-- 已结束：绿色 -->
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Background" Value="#71ff01"/>
                                                            </DataTrigger>
                                                            <!-- 进行中：蓝色 -->
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Background" Value="#02a7f0"/>
                                                            </DataTrigger>
                                                            <!-- 准备中：紫色 -->
                                                            <DataTrigger Binding="{Binding Status}" Value="Preparing">
                                                                <Setter Property="Background" Value="#8400ff"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>

                                            <!-- 内容区域 -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" 
                                                        Foreground="{DynamicResource TextPrimary}"/>

                                                <!-- 描述 + 状态文字 组合 -->
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <!-- 地点描述（线上） -->
                                                    <TextBlock Text="{Binding Description}" FontSize="12" 
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                                    <!-- 分隔符 -->
                                                    <TextBlock Text="·" FontSize="12" Foreground="Gray" Margin="4,0"/>
                                                    <!-- 状态文字（通过 DataTrigger 动态改变） -->
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <!-- 默认显示“准备中” -->
                                                                <Setter Property="Text" Value="准备中"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                        <Setter Property="Text" Value="已结束"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                        <Setter Property="Text" Value="进行中"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Viewbox>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
